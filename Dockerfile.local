# 使用 Debian Bookworm 镜像
FROM node:18-bookworm-slim

WORKDIR /app

# 1. 设置 APT 清华镜像源并安装系统依赖
# 我们先备份原始源，然后替换为清华源
RUN sed -i 's/deb.debian.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && apt-get install -y \
    libatomic1 \
    libgomp1 \
    libzip4 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 2. 复制依赖描述文件
COPY package*.json ./

# 3. 设置 NPM 淘宝镜像并安装依赖
RUN npm config set registry https://registry.npmmirror.com && \
    npm install --production

# 4. 复制应用代码
COPY . .

# 5. 显式复制 AI 引擎文件
COPY ai/bin/katago /app/ai/bin/katago
COPY ai/bin/pikafish /app/ai/bin/pikafish

# 6. 设置执行权限
RUN chmod +x /app/ai/bin/katago/katago && \
    chmod +x /app/ai/bin/pikafish/pikafish

# 7. 验证引擎文件及依赖环境 (这是你最关心的 ldd 检查)
RUN echo "========== AI 引擎及依赖验证 ==========" && \
    echo "1. 检查文件:" && \
    ls -lh /app/ai/bin/katago/katago && \
    ls -lh /app/ai/bin/pikafish/pikafish && \
    echo "" && \
    echo "2. 验证动态链接库:" && \
    ldd /app/ai/bin/katago/katago || echo "KataGo 依赖检查失败" && \
    echo "-----------------------------------" && \
    ldd /app/ai/bin/pikafish/pikafish || echo "Pikafish 依赖检查失败" && \
    echo "====================================="

# 暴露端口
EXPOSE 9527

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:9527/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})" || exit 1

# 启动应用
CMD ["node", "server.js"]