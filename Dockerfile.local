# 本地构建方案：先下载引擎，再构建镜像
# 适用于网络不稳定的情况

FROM node:18-alpine

WORKDIR /app

# 安装运行时依赖
RUN apk add --no-cache libstdc++ libgomp

# 复制 package.json 并安装依赖
COPY package*.json ./
RUN npm install --production

# 复制应用代码（先复制，ai/bin 会被后面的 COPY 覆盖）
COPY . .

# 显式复制 AI 引擎文件（确保复制成功）
COPY ai/bin/katago /app/ai/bin/katago
COPY ai/bin/pikafish /app/ai/bin/pikafish

# 设置执行权限
RUN chmod +x /app/ai/bin/katago/katago 2>/dev/null || echo "KataGo 不存在" && \
    chmod +x /app/ai/bin/pikafish/pikafish 2>/dev/null || echo "Pikafish 不存在"

# 验证引擎文件
RUN echo "========== AI 引擎文件验证 ==========" && \
    echo "KataGo 目录:" && \
    ls -lh /app/ai/bin/katago/ && \
    echo "" && \
    echo "Pikafish 目录:" && \
    ls -lh /app/ai/bin/pikafish/ && \
    echo "" && \
    echo "检查可执行文件:" && \
    test -x /app/ai/bin/katago/katago && echo "✓ KataGo 可执行" || echo "✗ KataGo 不可执行" && \
    test -x /app/ai/bin/pikafish/pikafish && echo "✓ Pikafish 可执行" || echo "✗ Pikafish 不可执行" && \
    echo "====================================="

# 暴露端口
EXPOSE 9527

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:9527', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# 启动应用
CMD ["node", "server.js"]
